<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- Automated Actions -->

    <!-- Alert on Expired Suitability -->
    <record id="automated_action_suitability_expired" model="ir.actions.server">
        <field name="name">Alert: Suitability Expired</field>
        <field name="model_id" ref="model_finance_suitability"/>
        <field name="state">code</field>
        <field name="code">record.auto_expire_and_notify()</field>
    </record>

    <!-- Alert on Portfolio Rebalance Needed -->
    <record id="automated_action_portfolio_rebalance" model="ir.actions.server">
        <field name="name">Alert: Rebalancing Needed</field>
        <field name="model_id" ref="model_finance_portfolio"/>
        <field name="state">code</field>
        <field name="code">record.notify_rebalance_needed()</field>
    </record>

    </data>
</odoo>
